# QA-Turbo env
# Copy to .env (backend) / .env (frontend) and fill locally. Never commit .env.

# --- Backend (NestJS) ---
PORT=3001
NODE_ENV=development
# DATABASE_URL=postgres://...   # OPEN: DB not decided yet — see context/project-overview.md
# CORS_ORIGIN=http://localhost:3000
# Storage for BRD uploads (OPEN: local disk vs S3/Minio)
# UPLOAD_DIR=./uploads/brd
# LLM provider (OPEN: decide later — do NOT set a key until decided)
# LLM_PROVIDER=
# LLM_API_KEY=
# LLM_MODEL=

# --- Frontend (Nuxt) ---
# NUXT_PUBLIC_API_BASE=http://localhost:3001
