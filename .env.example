# QA-Turbo env
# Copy to .env (backend) / .env (frontend) and fill locally. Never commit .env.

# --- Backend (NestJS) ---
PORT=3001
NODE_ENV=development
# DATABASE_URL=postgres://...   # OPEN: DB not decided yet — see context/project-overview.md
# CORS_ORIGIN=http://localhost:3000
# Storage for BRD uploads (OPEN: local disk vs S3/Minio)
# UPLOAD_DIR=./uploads/brd
# LLM provider (OPEN: decide later — do NOT set a key until decided)
# LLM_PROVIDER=
# LLM_API_KEY=
# LLM_MODEL=

# --- Auth (Ticket 1) ---
# JWT secret — generate for real use: openssl rand -base64 48
# JWT_SECRET=change-me
# Session lifetime in seconds (default 28800 = 8h)
# JWT_TTL_SECONDS=28800
# Cookie name used for the session (default qt_session)
# SESSION_COOKIE_NAME=qt_session

# --- Frontend (Nuxt) ---
# NUXT_PUBLIC_API_BASE=http://localhost:3001
